<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>WuKongEasySDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>WuKongIM</Authors>
    <Description>Lightweight asynchronous WebSocket JSON-RPC client for WuKongIM.</Description>
    <PackageTags>WuKongIM;IM;WebSocket;messaging</PackageTags>
    <RepositoryUrl>https://github.com/WuKongIM/WuKongEasySDK-CSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/WuKongIM/WuKongEasySDK-CSharp</PackageProjectUrl>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
